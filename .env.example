# Copy to .env.local and fill in. Never commit .env.local.

# PayPal sandbox app: developer.paypal.com > Apps & Credentials (Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Same client ID, exposed to the browser for the PayPal button
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# Signs negotiated deals so the price can't be changed before checkout. Any long random string:
#   openssl rand -base64 32
DEAL_SECRET=

# Claude: negotiation (when a side is "claude"), claim triage and retail pack sizing
ANTHROPIC_API_KEY=

# Each round's supplier: a sandbox business account that receives its Payouts (90% at ship, holdback at release).
# DEMO is the oat milk round (Meadow Oat Co.), RECEIPTS the receipt-roll round (Brightline Paper Co.).
SUPPLIER_PAYPAL_EMAIL_DEMO=
SUPPLIER_PAYPAL_EMAIL_RECEIPTS=
# Used for any round without its own address above.
SUPPLIER_PAYPAL_EMAIL=
# Optional and public: shown with the round's supplier email in the console's "See it in PayPal" panel,
# so visitors can sign in and see the payouts arrive. Give both supplier accounts this same password.
SANDBOX_SUPPLIER_PASSWORD=
# Optional, shown on the shop page under the PayPal button so visitors to the hosted demo can pay.
# Use a dedicated sandbox personal account: this login is public. Read at build time.
NEXT_PUBLIC_SANDBOX_BUYER_EMAIL=
NEXT_PUBLIC_SANDBOX_BUYER_PASSWORD=

# Negotiation agents: each side is "claude" or "gemini" (default claude)
SHOP_AGENT_PROVIDER=claude
SUPPLIER_AGENT_PROVIDER=claude
GEMINI_API_KEY=

# Channel3 product search (retail benchmark), free tier at trychannel3.com
CHANNEL3_API_KEY=

# Render only: set it in the Render dashboard so the build can install Bryntum. Locally, npm login is enough.
# BRYNTUM_NPM_TOKEN=

# demo-video/ only: sandbox logins the recorder signs in with (buyer, Shoal's business account, the receipts supplier).
# Never shown on screen; keep them out of NEXT_PUBLIC_* values.
# DEMO_BUYER_EMAIL=
# DEMO_BUYER_PASSWORD=
# DEMO_SHOAL_EMAIL=
# DEMO_SHOAL_PASSWORD=
# DEMO_SUPPLIER_EMAIL=
# DEMO_SUPPLIER_PASSWORD=
