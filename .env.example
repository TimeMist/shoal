# Copy to .env.local and fill in. Never commit .env.local.

# PayPal sandbox app: developer.paypal.com > Apps & Credentials (Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Same client ID, exposed to the browser for the PayPal button
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# Signs negotiated deals so the price can't be changed before checkout. Any long random string:
#   openssl rand -base64 32
DEAL_SECRET=

# Claude: negotiation (when a side is "claude"), claim triage and retail pack sizing
ANTHROPIC_API_KEY=

# Second sandbox business account: the supplier. Receives the Payouts (90% at ship, holdback at release)
SUPPLIER_PAYPAL_EMAIL=

# Negotiation agents: each side is "claude" or "gemini" (default claude)
SHOP_AGENT_PROVIDER=claude
SUPPLIER_AGENT_PROVIDER=claude
GEMINI_API_KEY=

# Channel3 product search (retail benchmark), free tier at trychannel3.com
CHANNEL3_API_KEY=

# Render only: set it in the Render dashboard so the build can install Bryntum. Locally, npm login is enough.
# BRYNTUM_NPM_TOKEN=
